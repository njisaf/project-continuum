<div class="inventory-details">
    <div class="form-group">
        <label>{{localize "AVANT.Item.Affliction.OnsetLabel"}}</label>
        {{#if data.onset}}
            {{> systems/avant/templates/items/partials/duration.hbs base="system.onset" duration=data.onset units=onsetUnits}}
            <div class="item-controls">
                <a data-action="onset-delete"><i class="fa-solid fa-fw fa-times"></i></a>
            </div>
        {{else}}
            <div class="form-fields">
                <button type="button" data-action="onset-add"><i class="fa-solid fa-plus"></i>Add Onset</button>
            </div>
        {{/if}}
    </div>
    <div class="form-group">
        <label>{{localize "AVANT.Time.Duration"}}</label>
        {{> systems/avant/templates/items/partials/duration.hbs base="system.duration" duration=data.duration units=durationUnits}}
    </div>

    {{#if user.isGM}}
        <div class="form-group">
            <label for="{{fieldIdPrefix}}unidentified">{{localize "AVANT.Item.Effect.Unidentified"}}</label>
            <div class="form-fields">
                <input id="{{fieldIdPrefix}}unidentified" type="checkbox" name="system.unidentified" {{checked data.unidentified}} />
            </div>
        </div>
    {{/if}}

    <hr/>

    {{#if item.onsetDuration}}
        <div class="form-group">
            <label for="{{fieldIdPrefix}}onsetActive">{{localize "AVANT.Item.Affliction.OnsetActive"}}</label>
            <div class="form-fields">
                <input id="{{fieldIdPrefix}}onsetActive" type="checkbox" name="system.onset.active" {{checked data.onset.active}} {{disabled (not item.actor)}}>
            </div>
        </div>
    {{/if}}

    <div class="form-group">
        <label>{{localize "AVANT.Item.Affliction.StageLabel"}}</label>
        <select name="system.stage" data-dtype="Number" {{disabled (not item.actor)}}>
            {{#if item.onsetDuration}}
                {{selectOptions @root.stageOptions selected=item.stage}}
            {{else}}
                {{selectOptions (omit @root.stageOptions "0") selected=item.stage}}
            {{/if}}
        </select>
    </div>

</div>
