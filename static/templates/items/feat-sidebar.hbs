<div class="inventory-details">
    <div class="form-group">
        <label>{{localize "AVANT.Category"}}</label>
        <select name="system.category">
            {{selectOptions categories selected=data.category localize=true}}
        </select>
    </div>

    {{#if showPrerequisites}}
        <div class="prerequisites">
            <h4 class="tags-title">{{localize "AVANT.FeatPrereqLabel"}}</h4>
            <ul class="tags">
                {{#each data.prerequisites.value as |v k|}}
                    <li class="tag tag_transparent {{k}}">{{v.value}}</li>
                {{/each}}
            </ul>
        </div>
    {{/if}}
</div>
