<form autocomplete="off" spellcheck="off">
    <div class="form-group">
        <label>{{localize "AVANT.ItemBonusLabel"}}</label>
        <input type="text" name="itemBonus" value="{{data.itemBonus}}" placeholder="{{localize "AVANT.RollBonusPlaceholder"}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "AVANT.StatusBonusTitle"}}</label>
        <input type="text" name="statusBonus" value="{{data.statusBonus}}" placeholder="{{localize "AVANT.RollBonusPlaceholder"}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "AVANT.CircumstanceBonusTitle"}}</label>
        <input type="text" name="circumstanceBonus" value="{{data.circumstanceBonus}}" placeholder="{{localize "AVANT.RollBonusPlaceholder"}}"/>
    </div>
    <div class="form-group">
        <label>{{localize "AVANT.RollModeLabel"}}</label>
        <select name="rollMode">
            {{selectOptions rollModes selected=rollMode localize=true}}
        </select>
    </div>
</form>
