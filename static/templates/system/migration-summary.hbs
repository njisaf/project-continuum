<div class="container">
    {{#if options.troubleshoot}}
        <h3>{{localize "AVANT.Migrations.Summary.Troubleshoot.Hint" version=systemVersion}}</h3>
    {{else}}
        <h3>{{localize "AVANT.Migrations.Finished" version=systemVersion}}</h3>
    {{/if}}
    <div class="dialog-content">
        <table>
            <thead>
                <tr>
                    <th>{{localize "AVANT.Migrations.Summary.Documents"}}</th>
                    <th>{{localize "AVANT.Migrations.Summary.Migrated"}} / {{localize "AVANT.Migrations.Summary.Total"}}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{localize "AVANT.Actor.Plural"}}</td>
                    <td><span class="docs-successful">{{actors.successful}}</span> / {{actors.total}}</td>
                    <td>
                        {{#if (eq actors.successful actors.total)}}
                            <i class="fa-solid fa-check"></i>
                        {{else}}
                            <i class="fa-solid fa-xmark"></i>
                        {{/if}}
                    </td>
                </tr>
                <tr>
                    <td>{{localize "AVANT.Item.Plural"}}</td>
                    <td><span class="docs-successful">{{items.successful}}</span> / {{items.total}}</td>
                    <td>
                        {{#if (eq items.successful items.total)}}
                            <i class="fa-solid fa-check"></i>
                        {{else}}
                            <i class="fa-solid fa-xmark"></i>
                        {{/if}}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    {{#if helpResources}}
        <p class="help-resources">{{{helpResourcesText}}}</p>
    {{/if}}
    <div class="dialog-buttons">
        <button type="button" data-action="close">{{localize "AVANT.OK"}}</button>
        {{#if canRemigrate}}<button type="button" data-action="remigrate" {{disabled helpResources}}>{{localize "AVANT.Migrations.Summary.Remigrate"}}</button>{{/if}}
    </div>
</div>
