<form autocomplete="off">
    <div class="form-group">
        <label for="{{object.uuid}}-add-coins-pp">{{localize "AVANT.CurrencyPP"}}:</label>
        <input id="{{object.uuid}}-add-coins-pp" type="number" name="pp" value="0" min="0" step="1" />
    </div>
    <div class="form-group">
        <label for="{{object.uuid}}-add-coins-gp">{{localize "AVANT.CurrencyGP"}}:</label>
        <input id="{{object.uuid}}-add-coins-gp" type="number" name="gp" value="0" min="0" step="1" />
    </div>
    <div class="form-group">
        <label for="{{object.uuid}}-add-coins-sp">{{localize "AVANT.CurrencySP"}}:</label>
        <input id="{{object.uuid}}-add-coins-sp" type="number" name="sp" value="0" min="0" step="1" />
    </div>
    <div class="form-group">
        <label for="{{object.uuid}}-add-coins-cp">{{localize "AVANT.CurrencyCP"}}:</label>
        <input id="{{object.uuid}}-add-coins-cp" type="number" name="cp" value="0" min="0" step="1" />
    </div>
    <div class="form-group">
        <label for="{{object.uuid}}-add-coins-combine-stacks">{{localize "AVANT.AddCoinsCombineStacksLabel"}}</label>
        <input id="{{object.uuid}}-add-coins-combine-stacks" type="checkbox" name="combineStacks" checked />
    </div>
    <button type="submit"><i class="fa-regular fa-floppy-disk"></i>{{localize "AVANT.AddCoinsTitle"}}</button>
</form>
