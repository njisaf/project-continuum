<form autocomplete="off">
    {{#if isMagic}}
        <h1>{{localize "AVANT.identification.IdentifyMagicDCs"}}</h1>
        <table>
            <tbody>
                <tr data-skill="arcana" data-dc="{{dcs.arcana}}">
                    <th>{{localize "AVANT.Skill.Arcana"}}</th>
                    <td>{{dcs.arcana}}</td>
                </tr>
                <tr data-skill="nature" data-dc="{{dcs.nature}}">
                    <th>{{localize "AVANT.Skill.Nature"}}</th>
                    <td>{{dcs.nature}}</td>
                </tr>
                <tr data-skill="occultism" data-dc="{{dcs.occultism}}">
                    <th>{{localize "AVANT.Skill.Occultism"}}</th>
                    <td>{{dcs.occultism}}</td>
                </tr>
                <tr data-skill="religion" data-dc="{{dcs.religion}}">
                    <th>{{localize "AVANT.Skill.Religion"}}</th>
                    <td>{{dcs.religion}}</td>
                </tr>
            </tbody>
        </table>
    {{else}}
        <h1>
            {{localize (ifThen isAlchemical "AVANT.identification.IdentifyAlchemyDCs" "AVANT.identification.IdentifyGenericDCs")}}
        </h1>
        <table>
            <tbody>
                <tr data-skill="crafting" data-dc="{{dcs.crafting}}">
                    <th>{{localize "AVANT.Skill.Crafting"}}</th>
                    <td>{{dcs.crafting}}</td>
                </tr>
            </tbody>
        </table>
    {{/if}}
    <button type="button" class="post-skill-checks">
        <i class="fa-solid fa-message fa-fw"></i>{{localize "AVANT.identification.PostSkillsToChat"}}
    </button>
    <button type="button" class="update-identification" value="identified">
        <i class="fa-regular fa-circle-question"></i>{{localize "AVANT.identification.Identify"}}
    </button>
    <input type="hidden" name="status" />
</form>
