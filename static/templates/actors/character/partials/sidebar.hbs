{{!-- HEALTH --}}
<header>
    <h2>{{localize "AVANT.HitPointsHeader"}}</h2>
    {{!-- <button
        type="button"
        class="hover"
        data-tooltip-content="#{{options.id}}-hp-modifiers">{{localize "AVANT.ModifiersTitle"}}</button> --}}
</header>

{{!-- New simplified HP section --}}
<div class="hitpoints simplified">
    <div class="hp-simplified">
        <span class="sidebar_label">{{localize "AVANT.HitPoints"}}</span>
        <input 
            type="text" 
            name="system.attributes.simpleHP"
            data-allow-delta
            value="{{data.attributes.simpleHP}}"
            placeholder="{{data.attributes.simpleHP}}" 
        />
    </div>
</div>

{{#with data.attributes.hp}}
    {{> "systems/avant/templates/actors/partials/modifiers-tooltip.hbs" title="AVANT.HitPointsHeader"}}
{{/with}}

{{!-- STAMINA (if enabled) --}}
{{#if hasStamina}}
    <header>
        <h2>{{localize "AVANT.StaminaPointsHeader"}}</h2>
    </header>
    <ol class="stamina">
        <li class="sp">
            <label for="{{options.id}}-pc-stamina" class="sidebar_label">{{localize "AVANT.StaminaPointsShortLabel"}}</label>
            <div class="hp-current stamina-group">
                <input
                    id="{{options.id}}-pc-stamina"
                    class="left"
                    type="number"
                    min="0"
                    max="{{data.attributes.hp.sp.max}}"
                    name="system.attributes.hp.sp.value"
                    value="{{data.attributes.hp.sp.value}}"
                />
                <span class="divider">&sol;</span>
                <input class="right" type="number" value="{{data.attributes.hp.sp.max}}" disabled="disabled" />
            </div>
        </li>
        <li class="resolve">
            <label for="{{options.id}}-pc-resolve" class="sidebar_label">{{localize "AVANT.Actor.Resource.Resolve"}}</label>
            <div class="hp-max stamina-group">
                <input
                    id="{{options.id}}-pc-resolve"
                    class="left"
                    type="number"
                    min="0"
                    max="{{data.resources.resolve.max}}"
                    name="system.resources.resolve.value"
                    value="{{data.resources.resolve.value}}"
                />
                <span class="divider">&sol;</span>
                <input class="right" type="number" value="{{data.resources.resolve.max}}" disabled="disabled" />
            </div>
        </li>
    </ol>
{{/if}}

{{!-- SPEEDS --}}
<header>
    <h2>{{localize "AVANT.Actor.Speed.Plural"}}</h2>
</header>
<div class="speeds">
    <div class="speed">
        <div class="label">{{localize "AVANT.Actor.Speed.Type.Land"}}</div>
        <div class="value" data-tooltip="{{speeds.[0].breakdown}}">
            {{{speeds.[0].icon}}}
            <input type="number" name="system.attributes.speed.value" class="number" value="{{speeds.[0].value}}" data-dtype="Number" />
            <span class="unit">{{localize "AVANT.TravelSpeed.FeetAcronym"}}</span>
        </div>
    </div>
</div>

{{#if specialResources}}
    <header>
        <h2>{{localize "AVANT.Actor.Resources"}}</h2>
    </header>
    <ol>
        {{#each specialResources as |resource|}}
            <li class="special-resource">
                <span class="label">{{resource.label}}</span>
                <input type="text" data-resource="{{resource.slug}}" value="{{resource.value}}" />
                / {{resource.max}}
            </li>
        {{/each}}
    </ol>
{{/if}}
