<section class="tab proficiencies major" data-group="primary" data-tab="proficiencies">
    <header>{{localize "AVANT.CoreSkillsHeader"}}</header>

    <!-- Might Skills -->
    <div class="attribute-skills-group">
        <h3 class="attribute-header">
            Might
            {{#if document.abilities.mgt}}
            <span class="ability-modifier">{{numberFormat document.abilities.mgt.mod decimals=0 sign=true}}</span>
            {{/if}}
        </h3>
        <ul class="proficiencies-list">
            {{#each data.skills as |skill key|}}
                {{#unless skill.lore}}
                    {{#if (or (eq key "command") (eq key "force") (eq key "surge"))}}
                    <li data-statistic="{{skill.slug}}">
                        <a class="d20" data-action="roll-check">
                            {{> "systems/avant/templates/actors/character/icons/d20.hbs"}}
                        </a>
                        <a class="modifier hover" data-tooltip-content="#{{@root.options.id}}-{{skill.slug}}-modifiers" data-tooltip="{{skill.breakdown}}">
                            {{numberFormat skill.value decimals=0 sign=true}}
                        </a>
                        <div class="name">{{localize skill.label}}</div>
                        <select
                            class="skill-proficiency pf-rank"
                            data-property="system.skills.{{key}}.rank"
                            data-rank="{{skill.rank}}"
                            data-dtype="Number"
                        >
                            {{> "systems/avant/templates/actors/character/partials/proficiencylevels-dropdown.hbs" proflevel=skill.rank}}
                        </select>
                        {{#with skill}}
                            {{> "systems/avant/templates/actors/partials/modifiers-tooltip.hbs" abpEnabled=@root.abpEnabled title=label}}
                        {{/with}}
                    </li>
                    {{/if}}
                {{/unless}}
            {{/each}}
        </ul>
    </div>

    <!-- Grace Skills -->
    <div class="attribute-skills-group">
        <h3 class="attribute-header">
            Grace
            {{#if document.abilities.gra}}
            <span class="ability-modifier">{{numberFormat document.abilities.gra.mod decimals=0 sign=true}}</span>
            {{/if}}
        </h3>
        <ul class="proficiencies-list">
            {{#each data.skills as |skill key|}}
                {{#unless skill.lore}}
                    {{#if (or (eq key "charm") (eq key "finesse") (eq key "hide"))}}
                    <li data-statistic="{{skill.slug}}">
                        <a class="d20" data-action="roll-check">
                            {{> "systems/avant/templates/actors/character/icons/d20.hbs"}}
                        </a>
                        <a class="modifier hover" data-tooltip-content="#{{@root.options.id}}-{{skill.slug}}-modifiers" data-tooltip="{{skill.breakdown}}">
                            {{numberFormat skill.value decimals=0 sign=true}}
                        </a>
                        <div class="name">{{localize skill.label}}</div>
                        <select
                            class="skill-proficiency pf-rank"
                            data-property="system.skills.{{key}}.rank"
                            data-rank="{{skill.rank}}"
                            data-dtype="Number"
                        >
                            {{> "systems/avant/templates/actors/character/partials/proficiencylevels-dropdown.hbs" proflevel=skill.rank}}
                        </select>
                        {{#with skill}}
                            {{> "systems/avant/templates/actors/partials/modifiers-tooltip.hbs" abpEnabled=@root.abpEnabled title=label}}
                        {{/with}}
                    </li>
                    {{/if}}
                {{/unless}}
            {{/each}}
        </ul>
    </div>

    <!-- Intellect Skills -->
    <div class="attribute-skills-group">
        <h3 class="attribute-header">
            Intellect
            {{#if document.abilities.intl}}
            <span class="ability-modifier">{{numberFormat document.abilities.intl.mod decimals=0 sign=true}}</span>
            {{/if}}
        </h3>
        <ul class="proficiencies-list">
            {{#each data.skills as |skill key|}}
                {{#unless skill.lore}}
                    {{#if (or (eq key "debate") (eq key "inspect") (eq key "recall"))}}
                    <li data-statistic="{{skill.slug}}">
                        <a class="d20" data-action="roll-check">
                            {{> "systems/avant/templates/actors/character/icons/d20.hbs"}}
                        </a>
                        <a class="modifier hover" data-tooltip-content="#{{@root.options.id}}-{{skill.slug}}-modifiers" data-tooltip="{{skill.breakdown}}">
                            {{numberFormat skill.value decimals=0 sign=true}}
                        </a>
                        <div class="name">{{localize skill.label}}</div>
                        <select
                            class="skill-proficiency pf-rank"
                            data-property="system.skills.{{key}}.rank"
                            data-rank="{{skill.rank}}"
                            data-dtype="Number"
                        >
                            {{> "systems/avant/templates/actors/character/partials/proficiencylevels-dropdown.hbs" proflevel=skill.rank}}
                        </select>
                        {{#with skill}}
                            {{> "systems/avant/templates/actors/partials/modifiers-tooltip.hbs" abpEnabled=@root.abpEnabled title=label}}
                        {{/with}}
                    </li>
                    {{/if}}
                {{/unless}}
            {{/each}}
        </ul>
    </div>

    <!-- Focus Skills -->
    <div class="attribute-skills-group">
        <h3 class="attribute-header">
            Focus
            {{#if document.abilities.foc}}
            <span class="ability-modifier">{{numberFormat document.abilities.foc.mod decimals=0 sign=true}}</span>
            {{/if}}
        </h3>
        <ul class="proficiencies-list">
            {{#each data.skills as |skill key|}}
                {{#unless skill.lore}}
                    {{#if (or (eq key "discern") (eq key "endure") (eq key "intuit"))}}
                    <li data-statistic="{{skill.slug}}">
                        <a class="d20" data-action="roll-check">
                            {{> "systems/avant/templates/actors/character/icons/d20.hbs"}}
                        </a>
                        <a class="modifier hover" data-tooltip-content="#{{@root.options.id}}-{{skill.slug}}-modifiers" data-tooltip="{{skill.breakdown}}">
                            {{numberFormat skill.value decimals=0 sign=true}}
                        </a>
                        <div class="name">{{localize skill.label}}</div>
                        <select
                            class="skill-proficiency pf-rank"
                            data-property="system.skills.{{key}}.rank"
                            data-rank="{{skill.rank}}"
                            data-dtype="Number"
                        >
                            {{> "systems/avant/templates/actors/character/partials/proficiencylevels-dropdown.hbs" proflevel=skill.rank}}
                        </select>
                        {{#with skill}}
                            {{> "systems/avant/templates/actors/partials/modifiers-tooltip.hbs" abpEnabled=@root.abpEnabled title=label}}
                        {{/with}}
                    </li>
                    {{/if}}
                {{/unless}}
            {{/each}}
        </ul>
    </div>

    {{!-- Lore Header --}}
    <header>
        {{localize "AVANT.LoreSkillsHeader"}}
        <div class="controls">
            <button type="button" data-action="create-item" data-tooltip="AVANT.CreateSkillTitle" data-type="lore">
                <i class="fa-solid fa-fw fa-plus"></i>{{localize "AVANT.AddShortLabel"}}
            </button>
        </div>
    </header>

    <ul class="proficiencies-list lores-list">
        {{!-- Lore Skills --}}
        {{#each data.skills as |skill idx|}}
            {{#if skill.lore}}
                <li class="item" data-item-id="{{skill.itemId}}" data-item-type="lore" data-statistic="{{skill.slug}}">
                    <a class="d20" data-action="roll-check" data-tooltip="{{skill.breakdown}}">
                        {{> "systems/avant/templates/actors/character/icons/d20.hbs"}}
                    </a>
                    <a class="modifier" data-action="roll-check">{{numberFormat skill.value decimals=0 sign=true}}</a>
                    <input class="name" data-item-id="{{skill.itemId}}" data-item-property="name" type="text" value="{{skill.label}}" />
                    <select class="skill-proficiency pf-rank adjust-item-stat-select" data-item-property="system.proficient.value" data-tooltip="{{skill.breakdown}}" data-rank="{{skill.rank}}">
                        {{> "systems/avant/templates/actors/character/partials/proficiencylevels-dropdown.hbs" proflevel=skill.rank}}
                    </select>
                    {{#if ../editable}}
                        <div class="item-controls">
                            <a data-action="delete-item" data-tooltip="AVANT.DeleteItemTitle"><i class="fa-solid fa-fw fa-trash"></i></a>
                        </div>
                    {{/if}}
                </li>
            {{/if}}
        {{/each}}
    </ul>

    {{!-- Attacks --}}
    <header class="attacks-defenses">
        {{localize "AVANT.Actor.Character.Proficiency.Attack.Title"}}
        <div class="controls">
            <button type="button" data-action="add-attack-proficiency" data-tooltip="AVANT.AddCombatProficiency.Title">
                <i class="fa-solid fa-fw fa-plus"></i>{{localize "AVANT.AddShortLabel"}}
            </button>
        </div>
    </header>

    <ul class="proficiencies-list combat-list">
        {{#each martialProficiencies.attacks as |proficiency key|}}
            <li{{#if proficiency.custom}} class="custom"{{/if}} data-slug="{{key}}">
                {{#if (and proficiency.custom @root.editable)}}
                    <a class="delete" data-action="delete-attack-proficiency"><i class="fa-solid fa-fw fa-trash"></i></a>
                {{/if}}
                <span class="modifier" data-tooltip="{{proficiency.breakdown}}">{{numberFormat proficiency.value decimals=0 sign=true}}</span>
                <span class="name">{{localize proficiency.label}}</span>
                <select
                    class="skill-proficiency pf-rank{{#unless proficiency.custom}} readonly{{/unless}}"
                    data-property="system.proficiencies.attacks.{{key}}.rank"
                    data-rank="{{proficiency.rank}}"
                    data-dtype="Number"
                >
                    {{> "systems/avant/templates/actors/character/partials/proficiencylevels-dropdown.hbs" proflevel=proficiency.rank}}
                </select>
            </li>
        {{/each}}
    </ul>

    {{!-- Defenses --}}
    <header class="attacks-defenses">
        {{localize "AVANT.Actor.Character.Proficiency.Defense.Title"}}
    </header>
    <ul class="proficiencies-list combat-list">
        {{#each martialProficiencies.defenses as |proficiency key|}}
            <li{{#if (and @first @last)}} class="all-by-myself"{{/if}} data-slug="{{key}}">
                <span class="modifier" data-tooltip="{{proficiency.breakdown}}">{{numberFormat proficiency.value decimals=0 sign=true}}</span>
                <span class="name">{{localize proficiency.label}}</span>
                <span class="pf-rank" data-rank="{{proficiency.rank}}">{{lookup @root.numberToRank proficiency.rank}}</span>
            </li>
        {{/each}}
    </ul>

    {{!-- Spellcasting --}}
    {{#if (gt actor.system.proficiencies.spellcasting.rank 0)}}
        <header>{{localize "AVANT.Item.Spell.Plural"}}</header>
        <ul class="proficiencies-list">
            {{#with document.spellcasting.base as |spellcasting|}}
                <li class="all-by-myself" data-slug="spellcasting">
                    <span class="modifier" data-tooltip="{{spellcasting.breakdown}}">{{numberFormat spellcasting.mod decimals=0 sign=true}}</span>
                    <span class="name">{{localize spellcasting.label}}</span>
                    <span class="pf-rank" data-rank="{{spellcasting.rank}}">{{lookup @root.numberToRank spellcasting.rank}}</span>
                </li>
            {{/with}}
        </ul>
    {{/if}}

    {{!-- Class DCs --}}
    {{#if classDCs.dcs}}
        <header>{{localize "AVANT.Actor.Character.ClassDC.Plural"}}</header>
        <ul class="proficiencies-list">
            {{#each classDCs.dcs as |classDC|}}
                <li{{#if (and @first @last)}} class="all-by-myself"{{else if (not classDC.primary)}} class="secondary"{{/if}}>
                    <a class="dc hover" data-tooltip-content="#{{../options.id}}-{{classDC.slug}}-modifiers" data-tooltip="{{classDC.breakdown}}">{{classDC.dc}}</a>
                    <span class="name">{{classDC.label}}</span>
                    <span class="pf-rank" data-rank="{{classDC.rank}}">{{lookup @root.numberToRank classDC.rank}}</span>
                    {{#with classDC}}
                        {{> "systems/avant/templates/actors/partials/modifiers-tooltip.hbs" title="AVANT.Actor.Character.ClassDC.Label"}}
                    {{/with}}
                </li>
            {{/each}}
        </ul>
    {{/if}}
</section>

<style>
.attribute-skills-group {
    margin-bottom: 1em;
}

.attribute-header {
    font-weight: bold;
    color: #5e0000;
    margin-top: 0.5em;
    margin-bottom: 0.5em;
    border-bottom: 1px solid #ddd;
    padding-bottom: 3px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.ability-modifier {
    color: #444;
    font-size: 0.9em;
    font-weight: normal;
    background: rgba(0, 0, 0, 0.05);
    padding: 2px 6px;
    border-radius: 3px;
}
</style>
