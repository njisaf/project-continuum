<section class="tab character major" data-group="primary" data-tab="character">
    <div class="subsection details">
        <div class="image-container">
            <img
                class="actor-image"
                src="{{actor.img}}"
                alt="{{actor.name}}"
                {{#if editable}}data-edit="img"{{/if}}
            />
            <a class="hover-icon" data-action="show-image" data-tooltip="SIDEBAR.CharArt"><i class="fa-solid fa-image fa-fw"></i></a>
        </div>

        <div class="abcd">
            <ul class="tags traits paizo-style">
                {{#if ancestry}}
                    <li class="tag size">{{localize (lookup actorSizes data.traits.size.value)}}</li>
                {{/if}}
                {{#each traits as |trait slug|}}
                    <li class="tag" data-slug="{{slug}}">{{trait.label}}</li>
                {{/each}}
            </ul>

            <div class="detail ancestry{{#if ancestry}} selected{{/if}}">
                {{> detailItem item=ancestry type="ancestry" compendium="avant.ancestries"}}
            </div>

            <div class="detail culture{{#if heritage}} selected{{/if}}">
                {{> detailItem item=heritage type="culture" compendium="avant.heritages"}}
            </div>

            <div class="detail vocation{{#if background}} selected{{/if}}">
                {{> detailItem item=background type="vocation" compendium="avant.backgrounds"}}
            </div>
        </div>

        <hr />
    </div>

    <div class="subsection background">
        <label>
            <span class="details-label">{{localize "AVANT.Background"}}</span>
            <textarea class="details-input" name="system.details.background.value" rows="4">{{data.details.background.value}}</textarea>
        </label>
    </div>

    <div class="subsection speeds">
        <header>
            <span>{{localize "AVANT.Actor.Speed.Plural"}}</span>
        </header>

        <div class="speed">
            <div class="label">{{localize "AVANT.Actor.Speed.Type.Land"}}</div>
            <div class="value" data-tooltip="{{speeds.[0].breakdown}}">
                {{{speeds.[0].icon}}}
                <input type="number" name="system.attributes.speed.value" class="number" value="{{speeds.[0].value}}" data-dtype="Number" />
                <span class="unit">{{localize "AVANT.TravelSpeed.FeetAcronym"}}</span>
            </div>
        </div>
    </div>
</section>

{{#*inline "detailItem"}}
    <span class="details-label">{{localize (concat "TYPES.Item." type)}}</span>
    <h3>
        <span class="value">{{item.name}}</span>
        {{#if @root.editable}}
            {{#if item}}
                <span class="detail-item-control" data-item-id="{{item.id}}"><i class="fa-solid fa-fw fa-ellipsis-v"></i></span>
            {{else}}
                <a data-action="open-abc-picker" data-item-type="{{type}}"><i class="fa-solid fa-fw fa-search"></i></a>
            {{/if}}
        {{/if}}
        {{#if showEmblem}}
            <div class="emblem">
                <img src="{{item.img}}" alt="{{item.name}}" />
            </div>
        {{/if}}
    </h3>
{{/inline}}
