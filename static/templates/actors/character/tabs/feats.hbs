<section class="tab feats feats-pane" data-group="primary" data-tab="feats">
    {{#each feats as |section|}}
        <section class="feat-section major" data-group-id="{{section.id}}">
            <header>
                {{localize section.label}}
                {{#with section.customLimit}}
                    <span class="limit">
                        ({{localize label}} <input type="number" name="{{concat "flags.avant.featLimits." section.id}}" value="{{section.limit}}" min="{{min}}" max="{{max}}" step="1"/>)
                    </span>
                {{/with}}
                <div class="controls">
                    {{#if (eq section.id "bonus")}}
                        <button type="button" data-action="create-feat">
                            <i class="fa-solid fa-fw fa-plus"></i>{{localize "AVANT.Actor.Character.CreateFeat"}}
                        </button>
                    {{/if}}
                    <button
                        type="button"
                        data-action="browse-feats"
                        data-type="feat"
                    >
                        <i class="fa-solid fa-fw fa-search"></i>{{localize "AVANT.BrowseLabel"}}
                    </button>
                </div>
            </header>
            <ol class="feats-list" data-foundry-list>
                {{#each section.feats as |featSlot|}}
                    {{> "systems/avant/templates/actors/character/partials/feat-slot.hbs" featSlot=featSlot featFilter=section.featFilter}}
                {{/each}}
            </ol>
        </section>
    {{/each}}
</section>
