<div class="hover-content modifiers-tooltip" id="{{@root.options.id}}-{{slug}}-modifiers" data-stat="{{slug}}">
    <div class="sidebar_title">
        <h2>{{localize title}}</h2>
    </div>
    <ul class="modifier-list">
        {{!-- Coalesce until `StatisticModifier` is removed --}}
        {{#each (coalesce modifiers _modifiers) as |modifier|}}
            {{#if (or modifier.enabled (not modifier.hideIfDisabled))}}
                <li class="item {{#unless modifier.enabled}}no-effect{{/unless}}">
                    <span class="tag-legacy">
                        {{localize (concat "AVANT.ModifierType." modifier.type)}}
                    </span>
                    <span class="label">{{modifier.label}}</span>
                    <span class="data">{{numberFormat modifier.modifier decimals=0 sign=true}}</span>
                    {{#if modifier.custom}}
                        <i class="fa-regular fa-circle-xmark remove-modifier" data-action="remove-modifier" data-slug="{{modifier.slug}}" title="{{localize "AVANT.RemoveModifierTitle"}}"></i>
                    {{/if}}
                </li>
            {{/if}}
        {{/each}}
        {{#if @root.editable}}
            <li class="item add-modifier">
                <div class="add-modifier-value">
                    <input type="number" placeholder="+1">
                    <i class="fa-solid fa-circle-plus" data-action="increment"></i>
                    <i class="fa-solid fa-minus-circle" data-action="decrement"></i>
                </div>

                <input type="text" class="add-modifier-name" placeholder={{localize "AVANT.ModifierNamePlaceholder"}}>

                <select class="tag-legacy add-modifier-type">
                    <option value="">{{localize "AVANT.ModifierTypeTitle"}}</option>
                    <option value="ability">{{localize "AVANT.ModifierType.ability"}}</option>
                    <option value="proficiency">{{localize "AVANT.ModifierType.proficiency"}}</option>
                    <option value="item">{{localize "AVANT.ModifierType.item"}}</option>
                    <option value="status">{{localize "AVANT.ModifierType.status"}}</option>
                    <option value="circumstance">{{localize "AVANT.ModifierType.circumstance"}}</option>
                    {{#if abpEnabled}}<option value="potency">{{localize "AVANT.ModifierType.potency"}}</option>{{/if}}
                    <option value="untyped">{{localize "AVANT.ModifierType.untyped"}}</option>
                </select>

                <button type="button" class="add-modifier-submit" data-action="create-custom-modifier">{{localize "AVANT.AddModifierTitle"}}</button>
            </li>
        {{/if}}
    </ul>
</div>
